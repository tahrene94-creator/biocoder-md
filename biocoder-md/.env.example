# Copy to .env.local and fill in real values. Never commit .env.local.
# .env.local is already covered by the default Next.js .gitignore.

# --- Auth (Clerk or NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # openssl rand -base64 32
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Database ---
DATABASE_URL=               # postgresql://user:pass@host:5432/db?sslmode=require

# --- ML inference backend ---
INFERENCE_API_BASE_URL=     # e.g. https://api.biocodermd.com
INFERENCE_API_KEY=

# --- FHIR / clinical apps ---
FHIR_BASE_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability / audit log sink ---
AUDIT_LOG_ENDPOINT=         # write-only sink; audit logs are never queryable from the app tier
SENTRY_DSN=
